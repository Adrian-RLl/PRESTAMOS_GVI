generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String
  usuarios Usuario[]
}

model Empresa {
  id       Int       @id @default(autoincrement())
  nombre   String
  estado   Boolean   @default(true)
  usuarios Usuario[]
  activos  Activo[]
}

model Gerencia {
  id       Int       @id @default(autoincrement())
  nombre   String
  estado   Boolean   @default(true)
  usuarios Usuario[]
}

model Area {
  id       Int       @id @default(autoincrement())
  nombre   String
  estado   Boolean   @default(true)
  usuarios Usuario[]
}

model Cargo {
  id       Int       @id @default(autoincrement())
  nombre   String
  estado   Boolean   @default(true)
  usuarios Usuario[]
}

model Sede {
  id       Int       @id @default(autoincrement())
  nombre   String
  estado   Boolean   @default(true)
  usuarios Usuario[]
}

model TipoActivo {
  id       Int       @id @default(autoincrement())
  nombre   String
  estado   Boolean   @default(true)
}

model Usuario {
  id               Int        @id @default(autoincrement())
  username         String?    @unique
  dni              String?    @unique
  nombre           String     // Mantendremos este como 'Nombre Completo'
  nombres          String?
  apellido_paterno String?
  apellido_materno String?
  correo           String?    @unique // Este será 'Correo Empresa'
  correo_personal  String?
  telefono_personal String?
  celular_personal String?
  celular_empresa  String?
  genero           String?
  contraseña       String
  activo           Boolean    @default(true)
  rol_id           Int
  rol              Rol        @relation(fields: [rol_id], references: [id])
  
  empresa_id       Int?
  empresa          Empresa?   @relation(fields: [empresa_id], references: [id])
  
  gerencia_id      Int?
  gerencia         Gerencia?  @relation(fields: [gerencia_id], references: [id])
  
  area_id          Int?
  area             Area?      @relation(fields: [area_id], references: [id])
  
  cargo_id         Int?
  cargo            Cargo?     @relation(fields: [cargo_id], references: [id])
  
  sede_id          Int?
  sede             Sede?      @relation(fields: [sede_id], references: [id])

  intentos_fallidos  Int        @default(0)
  bloqueado_hasta    DateTime?

  recuperar_token    String?    @unique
  recuperar_expira   DateTime?

  prestamos                Prestamo[] @relation("PrestamosUsuario")
  devoluciones_procesadas  Prestamo[] @relation("PrestamosReceptor")
  entregas_procesadas      Prestamo[] @relation("PrestamosEmisor")
  fecha_creacion   DateTime   @default(now())
}

model Activo {
  id                 Int        @id @default(autoincrement())
  tipo               String
  marca              String
  modelo             String
  serie              String     @unique
  estado             String // Disponible, Prestado, etc
  condicion          String? // Nuevo, Usado, Malogrado
  ubicacion          String
  observaciones      String?
  fecha_asignacion   DateTime?
  vigencia           String?
  fecha_creacion     DateTime   @default(now())
  
  empresa_id         Int?
  empresa            Empresa?   @relation(fields: [empresa_id], references: [id])
  orden_compra       String?

  prestamos          Prestamo[]
}

model Prestamo {
  id               Int      @id @default(autoincrement())
  usuario_id          Int
  activo_id           Int
  fecha_prestamo      DateTime
  fecha_devolucion    DateTime?
  estado              String
  firma_digital       String?  @db.Text
  firma_devolucion    String?  @db.Text
  devuelto_por_tercero String?
  
  usuario             Usuario  @relation("PrestamosUsuario", fields: [usuario_id], references: [id])
  
  usuario_receptor_id Int?
  usuario_receptor    Usuario? @relation("PrestamosReceptor", fields: [usuario_receptor_id], references: [id])
  
  usuario_emisor_id   Int?
  usuario_emisor      Usuario? @relation("PrestamosEmisor", fields: [usuario_emisor_id], references: [id])
  
  activo              Activo   @relation(fields: [activo_id], references: [id])
}